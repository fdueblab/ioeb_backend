# Flask 应用（本地开发，勿提交真实密钥）
FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=

# MCP 想定式封装：后端访问 Agent 的内部地址；两侧使用同一个随机令牌
MCP_AGENT_BASE_URL=http://127.0.0.1:8000
MCP_INTERNAL_TOKEN=
# 可选：持久化源码、封装包；默认位于 UPLOAD_FOLDER/mcp-packaging
MCP_PACKAGING_BASE_PATH=
# MCP 部署地址须与 docker-compose.yml 的 SERVICE_HOST_URL 一致
SERVICE_HOST_URL=https://fdueblab.cn

# 数据库（同步脚本与后端共用）
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# 飞书多维表格双向同步（scripts/sync_feedback_*.py 与 GitHub Actions 使用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# 飞书表需含列：反馈ID、提交用户、反馈内容、提交时间、处理状态（待处理/处理中/已采纳/已处理）、处理总结
